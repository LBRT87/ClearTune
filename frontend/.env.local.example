# Monad testnet — verify these against current Monad docs if they've changed.
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_EXPLORER_URL=https://testnet.monadexplorer.com

# WalletConnect (RainbowKit) — get a free project id at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deployed contract addresses (fill in after `forge script script/Deploy.s.sol`)
NEXT_PUBLIC_CLEARTUNE_ADDRESS=
NEXT_PUBLIC_MOCKUSD_ADDRESS=

# Supabase — Project Settings -> API. Region should be Singapore
# (ap-southeast-1) — also used for the landing page's live-cursor
# broadcast, where US-region round-trip latency is visible as lag.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Backend signer — the address authorized on-chain via ClearTune.setBackend().
# This key calls reportPlays() from /api/reportPlays. Keep it server-only,
# fund it with a little MON for gas.
BACKEND_PRIVATE_KEY=
