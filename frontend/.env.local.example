# Monad testnet — verify these against current Monad docs if they've changed.
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_EXPLORER_URL=https://testnet.monadexplorer.com

# Privy — auth. Dashboard: https://dashboard.privy.io/ -> app -> Settings.
# App ID is public and safe in the client. App Secret is server-only: it is
# used in src/lib/privy-server.ts to verify the session token and to read the
# user's embedded wallet address from Privy, so the address can never be
# forged from a request body.
#
# In the Privy dashboard you must also: enable Google AND Email login, and
# set embedded wallet creation to "users without wallets". Email is the
# safety net — Google OAuth can fail inside in-app browsers (chat webviews).
# Without these two settings nobody can sign in and no wallet is minted.
#
# Leaving these blank does not break the app: wagmi mounts with an empty
# config, pages still render, and only the auth routes go dark.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Deployed contract addresses (fill in after `forge script script/Deploy.s.sol`)
NEXT_PUBLIC_CLEARTUNE_ADDRESS=
NEXT_PUBLIC_MOCKUSD_ADDRESS=

# Supabase — Project Settings -> API. Region should be Singapore
# (ap-southeast-1) — also used for the landing page's live-cursor
# broadcast, where US-region round-trip latency is visible as lag.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Backend signer — the address authorized on-chain via ClearTune.setBackend().
# This key calls reportPlays() from /api/reportPlays. Keep it server-only,
# fund it with a little MON for gas.
BACKEND_PRIVATE_KEY=
