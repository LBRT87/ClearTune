# Live cursor (tiket 06). Tanpa kedua variabel ini halaman tetap jalan normal —
# multiplayer sekadar tidak muncul, tidak ada layar rusak.
#
# Ambil dari Supabase Dashboard → Project Settings → API.
# Region WAJIB Singapore (ap-southeast-1): demo di Jakarta, region default US
# menambah ~200ms round-trip yang terlihat sebagai cursor tersendat.
#
# Anon key aman di klien: channel-nya publik (private: false), tidak ada tabel
# dan tidak ada RLS yang dilewati.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
