# Privy (tiket auth/01). Ambil dari https://dashboard.privy.io/ → app → Settings.
# App ID publik, aman di klien. App Secret server saja — dipakai
# `@privy-io/node` (BUKAN `@privy-io/server-auth`, itu nama lama) di
# `lib/privy-server.ts` untuk memverifikasi token dan mengambil alamat wallet
# dari Privy, supaya alamatnya tidak bisa dikarang dari body request.
#
# Login methods: nyalakan Google DAN Email di dashboard. Email adalah jaring
# pengaman: Google OAuth bisa mati di in-app browser (webview chat).
# Pakai kredensial OAuth default Privy — bikin OAuth app Google sendiri itu
# pekerjaan produksi, bukan syarat jalan.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Live cursor (tiket landing-page/06). Tanpa kedua variabel ini halaman tetap
# jalan normal — multiplayer sekadar tidak muncul, tidak ada layar rusak.
#
# Ambil dari Supabase Dashboard → Project Settings → API.
# Region WAJIB Singapore (ap-southeast-1): demo di Jakarta, region default US
# menambah ~200ms round-trip yang terlihat sebagai cursor tersendat.
#
# Anon key aman di klien: channel-nya publik (private: false), tidak ada tabel
# dan tidak ada RLS yang dilewati.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Tiket auth/06. Service role key melewati RLS — server saja, jangan pernah
# diberi prefix NEXT_PUBLIC. Klien tidak pernah menyentuh tabel `profiles`.
SUPABASE_SERVICE_ROLE_KEY=

# Tiket auth/06. Dompet yang mengirim MON ke wallet user baru, supaya orang
# yang baru daftar punya gas untuk bertransaksi. Drip mengisi DOMPET, bukan
# saldo kontrak — spec §2.2: top-up adalah aksi eksplisit user.
DEPLOYER_PRIVATE_KEY=

# Alamat ClearTune di Monad testnet. Selama kosong, jalur mUSD dilewati dan
# dashboard menampilkan "kontrak belum ter-deploy" secara jujur.
NEXT_PUBLIC_CONTRACT_ADDRESS=
